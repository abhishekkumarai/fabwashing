{
  "framework": null,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/seo-refresh",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|ico|svg|webp|avif))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
