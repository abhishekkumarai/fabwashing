# ---- Backend (Django) ----
# Local dev leaves DATABASE_URL unset -> falls back to SQLite.
# For Postgres (Docker/Render), set a full URL:
DATABASE_URL=postgres://laundry:laundry@localhost:5432/laundrypro
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# Comma-separated list of allowed frontend origins for CORS (blank = allow all, demo only)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend (Next.js) ----
# Base URL of the Django API. Must be set at BUILD time for the client bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000
